POSTGRES_URL=postgresql://postgres:password@host:6543/postgres?pgbouncer=true
DATABASE_SCHEMA=fleet_register_v2

MONITOR_PARENT_RPC_OVERRIDES={"1":"https://ethereum-rpc.publicnode.com","8453":"https://base-mainnet.g.alchemy.com/v2/REPLACE_ME","42161":"https://arb-mainnet.g.alchemy.com/v2/REPLACE_ME"}

# CoinGecko Demo API key (free — https://www.coingecko.com/en/api/pricing).
# Strongly recommended: the keyless public API caps token_price at ONE address
# per request and rate-limits hard, so per-token USD pricing (custom gas tokens,
# retryable deposits) is slow/partial without a key. With a key it's batched and
# instant. Use COINGECKO_PRO_API_KEY instead if you have a paid plan.
COINGECKO_API_KEY=

MONITOR_API_HOST=127.0.0.1
MONITOR_API_PORT=4010
MONITOR_API_CORS_ORIGIN=https://your-web-origin.example
MONITOR_WEB_API_BASE=https://monitor.your-domain.example
