# MONITOR_WORKER_MONITORS=assertion,batch-poster,retryable
MONITOR_DB_PATH=./monitoring.sqlite

MONITOR_API_HOST=0.0.0.0
MONITOR_API_PORT=4010
MONITOR_API_CORS_ORIGIN=http://localhost:4020

MONITOR_WORKER_ONCE=false
MONITOR_WORKER_POLL_INTERVAL_MS=60000

PORT=4020
