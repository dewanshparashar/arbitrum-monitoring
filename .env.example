POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/arbitrum_monitoring

# Optional: set this to force a local config file instead of the portal snapshot
# MONITOR_CONFIG_PATH=./config.json
MONITOR_PORTAL_CONFIG_URL=https://raw.githubusercontent.com/OffchainLabs/arbitrum-portal/refs/heads/master/packages/arb-token-bridge-ui/src/util/orbitChainsData.json
MONITOR_PORTAL_NETWORK=all
# MONITOR_CHAIN_RPC_OVERRIDES={"37714555429":"https://testnet-v2.xai-chain.net/rpc"}
# MONITOR_PARENT_RPC_OVERRIDES={"421614":"https://sepolia-rollup.arbitrum.io/rpc"}
